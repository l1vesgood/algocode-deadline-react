{
  "name": "algocode-deadline-web",
  "version": "1.0.0",
  "description": "Deadline tracker for Algocode",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "nodemon server/index.js",
    "client": "npm run dev --prefix client",
